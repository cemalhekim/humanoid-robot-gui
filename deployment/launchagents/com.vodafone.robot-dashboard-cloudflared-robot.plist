<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vodafone.robot-dashboard-cloudflared-robot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/vodafone/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--url</string>
    <string>http://192.168.123.164:8088</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/robot-dashboard-remote/cloudflared-robot.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/robot-dashboard-remote/cloudflared-robot.err.log</string>
</dict>
</plist>
