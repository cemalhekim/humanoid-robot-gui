[Unit]
Description=Hans H1-2 MuJoCo twin (headless, DDS domain 1 on lo)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/humanoid-robot-gui
Environment=HANS_SIM_PYTHON=%h/hans-sim-env/bin/python
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/humanoid-robot-gui/simulation/h1_2_twin/run_h1_2_twin.sh --status-every 30
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
