[Unit]
Description=Unitree Inspire Hand Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/unitree_sdk2_python/example/h1_2
Environment=XR_INSPIRE_DEVICE=/dev/serial/by-path/pci-0000:00:14.0-usb-0:1.1:1.0-port0
Environment=XR_INSPIRE_LEFT_DEVICE=/dev/serial/by-path/pci-0000:00:14.0-usb-0:1.3:1.0-port0
Environment=XR_INSPIRE_NETWORK=eth0
# The supervisor used to live in ~/xr_teleoperate/deploy/scripts/, a checkout
# that update_xr_teleoperate.sh resets — every fix there was wiped on the next
# XR update. It is repo-owned now, so it deploys with the dashboard.
ExecStart=/home/unitree/robot_telemetry_web/deployment/start_inspire_hands.sh
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
