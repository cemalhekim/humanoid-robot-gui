[Unit]
Description=Robot Telemetry Web Dashboard
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/robot_telemetry_web
Environment=MAMBA_ROOT_PREFIX=/home/unitree/.micromamba
ExecStart=/home/unitree/.local/micromamba run -n tv python -u /home/unitree/robot_telemetry_web/server.py --host 0.0.0.0 --port 8088 --robot-host 192.168.123.164 --camera-source eth0
Restart=always
RestartSec=3
StandardOutput=append:/home/unitree/logs/robot_telemetry_web.log
StandardError=append:/home/unitree/logs/robot_telemetry_web.log

[Install]
WantedBy=default.target
