[Unit]
Description=Robot Telemetry Web Dashboard
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/robot_telemetry_web
Environment=MAMBA_ROOT_PREFIX=/home/unitree/.micromamba
# Auto-commit+push the pose-feedback CSV to the repo (robot only; the deploy
# key alone is no longer enough, so a dev with the key never pushes by accident).
Environment=FEEDBACK_SYNC_ENABLE=1
# Claude chat backend: the operator's Mac running tools/claude_bridge.py.
# The Mac's DHCP address can change — update here if the ✳ toggle reports
# the bridge unreachable.
Environment=CLAUDE_BRIDGE_URL=http://10.2.100.81:8399
# Loco (high-level LocoClient) velocity envelope multiplier. 1.0 = shipped
# LOCO_BASE_SPEED_LIMITS (vx ±1.0 m/s, vy ±0.5 m/s, vyaw ±1.0 rad/s); the server
# hard-caps the scale at 2.0. 2.0 here -> vx ±2.0, vy ±1.0, vyaw ±2.0.
# Remove the line (or set 1.0) to fall back to the shipped limits.
Environment=LOCO_SPEED_SCALE=2.0
# On a cold boot the dashboard can start before eth0 has its robot-network IP.
# The DDS participant then binds to a not-yet-ready interface and never receives
# rt/lowstate, so telemetry shows "disconnected" until a manual restart. Wait
# (up to 60s) for eth0 to come up with its 192.168.123.x address before starting
# so DDS binds to the correct interface; then it discovers the robot's telemetry
# as soon as the robot publishes. Start anyway after the timeout.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do ip -br addr show eth0 2>/dev/null | grep -Eq "UP .*192\\.168\\.123\\." && exit 0; sleep 1; done; echo "eth0 robot-network IP not ready after 60s; starting anyway" >&2; exit 0'
ExecStart=/home/unitree/.micromamba/envs/tv/bin/python -u /home/unitree/robot_telemetry_web/server.py --host 0.0.0.0 --port 8088 --robot-host 192.168.123.164 --camera-source eth0 --camera-backend teleimager
Restart=always
RestartSec=3
StandardOutput=append:/home/unitree/logs/robot_telemetry_web.log
StandardError=append:/home/unitree/logs/robot_telemetry_web.log

[Install]
WantedBy=default.target
