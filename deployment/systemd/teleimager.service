[Unit]
Description=Unitree TeleImager Image Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/unitree/teleimager
Environment=MAMBA_ROOT_PREFIX=/home/unitree/.micromamba
Environment=PYTHONPATH=src
Environment=XR_TELEOP_CERT=/home/unitree/.config/xr_teleoperate/cert.pem
Environment=XR_TELEOP_KEY=/home/unitree/.config/xr_teleoperate/key.pem
# The head camera is a "videohub" network source (Unitree VideoClient over DDS
# on eth0). The image server initializes it exactly ONCE at startup; on a cold
# boot the MCU's video service comes up later than this PC's user services, so
# that single attempt failed and the server ran degraded forever ("Waiting for
# Teleimager head camera frame") until a manual restart. Gate the start on the
# interface AND on the camera source actually answering GetImageSample.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do ip -br addr show eth0 2>/dev/null | grep -Eq "UP .*192\\.168\\.123\\." && exit 0; sleep 1; done; echo "eth0 robot-network IP not ready after 60s; starting anyway" >&2; exit 0'
ExecStartPre=/home/unitree/.micromamba/envs/tv/bin/python /home/unitree/robot_telemetry_web/deployment/wait_for_videohub.py
# ~/teleimager is a git checkout that update flows reset, wiping hand-edits to
# cam_config_server.yaml (enable_zmq flipped back to false after a reboot and
# the dashboard camera died). Re-apply the required config on EVERY start.
ExecStartPre=/home/unitree/.micromamba/envs/tv/bin/python /home/unitree/robot_telemetry_web/deployment/patch_teleimager_config.py
ExecStart=/home/unitree/.micromamba/envs/tv/bin/python -m teleimager.image_server
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
