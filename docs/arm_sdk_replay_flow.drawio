          <mxGeometry height="70" width="300" x="440" y="800" as="geometry" />
        </mxCell>
        <mxCell id="o200" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="200 {ok, recording, plan}&#xa;• NO motion — plan preview only" vertex="1">
          <mxGeometry height="60" width="200" x="850" y="805" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="payload.execute_arm_sdk is True?" vertex="1">
          <mxGeometry height="70" width="300" x="440" y="910" as="geometry" />
        </mxCell>
        <mxCell id="e409lock" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="409 LOCKED (default path)&#xa;“raw joint replay requires a safety controller:&#xa;interpolation, joint/vel/torque limits,&#xa;controller-ownership checks, e-stop supervision”" vertex="1">
          <mxGeometry height="80" width="300" x="820" y="905" as="geometry" />
        </mxCell>
        <mxCell id="gate_hdr" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#b85450;" value="execute_arm_sdk_replay(path, plan, payload)  —  GATE STACK (fail-closed)" vertex="1">
          <mxGeometry height="30" width="620" x="360" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="plan.control_path == “arm_sdk”?&#xa;(TRUE only if NO lower-body joint moves&#xa;beyond TRAJECTORY_ROUTE_EPSILON = 0.015 rad&#xa;— legs stay under Unitree onboard controller)" vertex="1">
