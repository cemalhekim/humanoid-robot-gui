        <mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="payload.preview_complete&#xa;is truthy?&#xa;(UI must run 3-ghost sim preview first)" vertex="1">
          <mxGeometry height="90" width="320" x="430" y="450" as="geometry" />
        </mxCell>
        <mxCell id="e400b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="400&#xa;preview must complete first" vertex="1">
