      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" value="Unitree H1-2 — Physical Arm Replay via rt/arm_sdk&#xa;server.py: request_robot_replay() → execute_arm_sdk_replay() → run_replay() thread" vertex="1">
          <mxGeometry height="60" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=6;" value="LEGEND&#xa;▪ Blue = process/step&#xa;▪ Orange = decision (guard)&#xa;▪ Red = reject / terminal error&#xa;▪ Green = data type / struct&#xa;▪ Purple = DDS I/O (CycloneDDS)&#xa;▪ Yellow = config constant" vertex="1">
          <mxGeometry height="140" width="230" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="START&#xa;POST /api/recording/replay/robot&#xa;(browser “Move Robot” button)" vertex="1">
          <mxGeometry height="60" width="300" x="440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="request_robot_replay(payload: dict)&#xa;payload = {filename, command_scope, preview_complete,&#xa;dry_run, execute_arm_sdk, replay_response,&#xa;position_tolerance_rad, closed_loop, hold_after_convergence}" vertex="1">
          <mxGeometry height="70" width="340" x="420" y="210" as="geometry" />
        </mxCell>
