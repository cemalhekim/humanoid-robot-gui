        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="path = recording_file_path(filename)&#xa;(resolves under RECORDINGS_DIR;&#xa;raises if path escapes dir → traversal guard)" vertex="1">
          <mxGeometry height="60" width="340" x="420" y="580" as="geometry" />
        </mxCell>
        <mxCell id="e404" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="404 file not found&#xa;/ 400 outside recordings dir" vertex="1">
          <mxGeometry height="60" width="200" x="850" y="580" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="plan = plan_replay_control_path(path, command_scope)&#xa;→ walks frames, computes per-joint max step &amp; velocity,&#xa;chooses control_path, builds gain_plan + hand_plan,&#xa;flags violations. See PLAN struct (right)." vertex="1">
          <mxGeometry height="80" width="340" x="420" y="680" as="geometry" />
        </mxCell>
