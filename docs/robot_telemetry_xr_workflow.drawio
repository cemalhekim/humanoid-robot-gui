        <mxCell id="svc_teleimager" value="teleimager.service&#xa;Exec: tv env python -m teleimager.image_server&#xa;WebRTC port 60001&#xa;head camera 1080p30 H.264" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
