        <mxCell id="svc_gui" value="robot-telemetry-web.service&#xa;Exec: tv env python server.py&#xa;Port 8088&#xa;serves GUI + API + SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
