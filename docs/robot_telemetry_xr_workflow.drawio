        </mxCell>
        <mxCell id="xr_headset" value="XR headset / browser&#xa;VR View: https://10.2.100.142:8012/?ws=wss://10.2.100.142:8012&#xa;permissions: camera / hand tracking / WebXR as required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8064a2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2090" y="350" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="operator" value="Human operator&#xa;head pose&#xa;hand joints&#xa;controller/gesture input&#xa;visual feedback loop" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eadcf8;strokeColor=#8064a2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2180" y="555" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="lane_alg" value="XR TELEOPERATION ALGORITHM + DATA PATHS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=16;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="2500" height="820" as="geometry" />
        </mxCell>

        <mxCell id="alg_xr_input" value="1. XR device samples input&#xa;WebXR/OpenXR hand landmarks&#xa;head pose / controller state&#xa;video display frame timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadcf8;strokeColor=#8064a2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="910" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="alg_televuer" value="2. TeleVuer / browser transport&#xa;HTTPS page on 8012&#xa;WebSocket WSS for XR telemetry&#xa;IPC command starts motion state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8064a2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="370" y="910" width="245" height="115" as="geometry" />
        </mxCell>
        <mxCell id="alg_arrays" value="3. teleop_hand_and_arm.py&#xa;shared arrays for left/right hand + pose&#xa;XR_SWAP_HAND_INPUTS optional&#xa;motion-ready gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddebf7;strokeColor=#5b9bd5;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="670" y="910" width="250" height="125" as="geometry" />
        </mxCell>
        <mxCell id="alg_arm" value="4A. Arm control branch&#xa;retarget human wrist/arm pose&#xa;IK / constraints / smoothing&#xa;publish Unitree arm commands over DDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="870" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alg_hand_direct" value="4B. Inspire direct curl branch&#xa;_direct_inspire_targets(hand_data, side)&#xa;finger curl = angle curl + fingertip distance&#xa;output order: [pinky, ring, middle, index, thumb_bend, thumb_rotation]&#xa;command range: 1=open, 0=closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="1040" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alg_hand_mapping" value="5. Hand mapping + gains&#xa;side-specific env gains&#xa;XR_INSPIRE_LEFT_PINKY_GAIN&#xa;XR_INSPIRE_LEFT_THUMB_ROT_GAIN&#xa;physical robot index patch currently maps observed left ids 0..5 and right ids 6..11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1040" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alg_dds_cmd" value="6. DDS command topics&#xa;rt/inspire/cmd to MotorCmds_ q[12]&#xa;rt/inspire/state from MotorStates_ q[12]&#xa;Unitree SDK2 Python / CycloneDDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1760" y="1040" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alg_motors" value="7. Physical actuation&#xa;Inspire bridge converts DDS q values&#xa;serial packets to DFX hands&#xa;motors move fingers&#xa;state is read back to DDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2110" y="1040" width="270" height="130" as="geometry" />
        </mxCell>

        <mxCell id="alg_camera_cap" value="Camera capture&#xa;head_camera via VideoHub&#xa;TeleImager config: 1920x1080 @ 30 FPS&#xa;H.264 WebRTC enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="1260" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="alg_webrtc" value="WebRTC media path&#xa;TeleImager image_server on 60001&#xa;UDP/SRTP media after signaling&#xa;browser video element displays stream&#xa;old /camera.mjpg path removed from primary preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="1260" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="alg_visual_feedback" value="Visual feedback loop&#xa;operator sees robot POV&#xa;updates hand/head motion&#xa;control loop repeats at XR_TELEOP_FREQUENCY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eadcf8;strokeColor=#8064a2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="1260" width="275" height="120" as="geometry" />
        </mxCell>

        <mxCell id="alg_gui_api" value="GUI control path&#xa;static/app.js to HTTP API in server.py&#xa;movement, posture, status, reset, test tools&#xa;server.py uses Unitree SDK clients over DDS/RPC where needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddebf7;strokeColor=#5b9bd5;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1280" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alg_diag" value="Diagnostics + tests&#xa;tools/rh56/inspire_left_hand_dds_scan.py&#xa;tools/rh56/inspire_left_pinky_dds_test.py&#xa;tools/rh56/rh56_port_probe.py&#xa;tools/robot_motion/* wrist/control probes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1280" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alg_latency" value="Latency levers&#xa;Measure: WebRTC getStats RTT, jitterBufferDelay, dropped frames&#xa;Control: test XR_TELEOP_FREQUENCY 60 vs 30&#xa;Video: compare 1080p30, 720p60, 720p30&#xa;Queues: latest-frame-only, drop stale data&#xa;Network: eth0 DDS, clean Wi-Fi for headset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1980" y="1260" width="390" height="165" as="geometry" />
        </mxCell>

