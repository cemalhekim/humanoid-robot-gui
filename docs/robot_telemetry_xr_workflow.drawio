          <mxGeometry x="1610" y="545" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="runtime_note" value="Runtime invariants&#xa;Ports expected open: 8088, 8012, 60001&#xa;CycloneDDS pinned to eth0&#xa;micromamba run avoided; services use tv env python directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#70ad47;fontSize=12;" vertex="1" parent="1">
