        </mxCell>

        <mxCell id="user_browser" value="Operator browser&#xa;GUI: http://10.2.100.142:8088&#xa;Camera Stream panel embeds iframe&#xa;https://10.2.100.142:60001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8064a2;fontSize=13;" vertex="1" parent="1">
