        </mxCell>
        <mxCell id="svc_xr" value="xr-teleop.service&#xa;start_xr_teleop.sh&#xa;teleop_hand_and_arm.py&#xa;Port 8012 HTTPS/WSS&#xa;--frequency 30, --ee inspire_dfx&#xa;--motion --headless --ipc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1290" y="340" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="svc_hands" value="inspire-hands.service&#xa;DFX_inspire_service/build/inspire_h1&#xa;DDS bridge: rt/inspire/cmd + state&#xa;Serial: /dev/ttyUSB0 + left-serial /dev/ttyUSB1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;fontSize=13;" vertex="1" parent="1">
