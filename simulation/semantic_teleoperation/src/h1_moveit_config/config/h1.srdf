<?xml version="1.0" encoding="UTF-8"?>
<robot name="h1">
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="pelvis"/>

  <group name="left_arm">
    <chain base_link="torso_link" tip_link="left_hand_link"/>
  </group>
  <group name="right_arm">
    <chain base_link="torso_link" tip_link="right_hand_link"/>
  </group>
  <group name="left_leg">
    <chain base_link="pelvis" tip_link="left_ankle_link"/>
  </group>
  <group name="right_leg">
    <chain base_link="pelvis" tip_link="right_ankle_link"/>
  </group>
  <group name="torso">
    <joint name="torso_joint"/>
  </group>
  <group name="left_hand">
    <joint name="L_thumb_proximal_yaw_joint"/>
    <joint name="L_thumb_proximal_pitch_joint"/>
    <joint name="L_thumb_intermediate_joint"/>
    <joint name="L_thumb_distal_joint"/>
    <joint name="L_index_proximal_joint"/>
    <joint name="L_index_intermediate_joint"/>
    <joint name="L_middle_proximal_joint"/>
    <joint name="L_middle_intermediate_joint"/>
    <joint name="L_ring_proximal_joint"/>
    <joint name="L_ring_intermediate_joint"/>
    <joint name="L_pinky_proximal_joint"/>
    <joint name="L_pinky_intermediate_joint"/>
  </group>
  <group name="right_hand">
    <joint name="R_thumb_proximal_yaw_joint"/>
    <joint name="R_thumb_proximal_pitch_joint"/>
    <joint name="R_thumb_intermediate_joint"/>
    <joint name="R_thumb_distal_joint"/>
    <joint name="R_index_proximal_joint"/>
    <joint name="R_index_intermediate_joint"/>
    <joint name="R_middle_proximal_joint"/>
    <joint name="R_middle_intermediate_joint"/>
    <joint name="R_ring_proximal_joint"/>
    <joint name="R_ring_intermediate_joint"/>
    <joint name="R_pinky_proximal_joint"/>
    <joint name="R_pinky_intermediate_joint"/>
  </group>
  <group name="whole_body">
    <group name="torso"/>
    <group name="left_arm"/>
    <group name="right_arm"/>
    <group name="left_leg"/>
    <group name="right_leg"/>
  </group>

  <group_state name="home" group="whole_body">
    <joint name="torso_joint" value="0"/>
    <joint name="left_hip_yaw_joint" value="0"/>
    <joint name="left_hip_roll_joint" value="0"/>
    <joint name="left_hip_pitch_joint" value="0"/>
    <joint name="left_knee_joint" value="0"/>
    <joint name="left_ankle_joint" value="0"/>
    <joint name="right_hip_yaw_joint" value="0"/>
    <joint name="right_hip_roll_joint" value="0"/>
    <joint name="right_hip_pitch_joint" value="0"/>
    <joint name="right_knee_joint" value="0"/>
    <joint name="right_ankle_joint" value="0"/>
    <joint name="left_shoulder_pitch_joint" value="0"/>
    <joint name="left_shoulder_roll_joint" value="0"/>
    <joint name="left_shoulder_yaw_joint" value="0"/>
    <joint name="left_elbow_joint" value="0"/>
    <joint name="left_hand_joint" value="0"/>
    <joint name="right_shoulder_pitch_joint" value="0"/>
    <joint name="right_shoulder_roll_joint" value="0"/>
    <joint name="right_shoulder_yaw_joint" value="0"/>
    <joint name="right_elbow_joint" value="0"/>
    <joint name="right_hand_joint" value="0"/>
  </group_state>

  <end_effector name="left_gripper" parent_link="left_hand_link" group="left_hand"/>
  <end_effector name="right_gripper" parent_link="right_hand_link" group="right_hand"/>

  <disable_collisions link1="left_hand_link" link2="L_hand_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_hand_link" link2="R_hand_base_link" reason="Adjacent"/>
</robot>
